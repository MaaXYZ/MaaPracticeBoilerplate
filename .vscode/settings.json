{
    "json.schemas": [
        {
            "fileMatch": [
                "/resource/**/*.json",
                "/install/resource/**/*.json",
                "/resource/**/*.jsonc",
                "/install/resource/**/*.jsonc"
            ],
            "url": "/tools/schema/pipeline.schema.json"
        },
        {
            "fileMatch": [
                "/interface.json",
                "/install/interface.json"
            ],
            "url": "/tools/schema/interface.schema.json"
        },
        {
            "fileMatch": [
                "/tasks/**/*.json",
                "/install/tasks/**/*.json"
            ],
            "url": "/tools/schema/interface_import.schema.json"
        },
        {
            "fileMatch": [
                "/install/config/maa_pi_config.json"
            ],
            "url": "/tools/schema/interface_config.schema.json"
        }
    ],
    "files.associations": {
        "/interface.json": "jsonc",
        "/resource/**/*.json": "jsonc"
    },
    "[json][jsonc]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.indentSize": "tabSize"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    }
}
